{
  "name": "motamyezon_for_text_books_v2",
  "version": "1.0.0",
  "description": "Motamyezon for Text Books A book-sharing platform focused on Arabic digital books. Users can browse, search, and download books, while trusted uploaders and admins can contribute new content. Built with Node.js, Express, MongoDB, and AWS S3 for secure file storage and role-based access.",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "test": "NODE_ENV=production DISABLE_RATE_LIMITING=true mocha \"tests/**/*.test.js\" --timeout 20000 --exit",
    "test:author": "NODE_ENV=production DISABLE_RATE_LIMITING=true mocha tests/author.test.js --timeout 20000 --exit",
    "test:series": "NODE_ENV=production DISABLE_RATE_LIMITING=true mocha tests/series.test.js --timeout 20000 --exit",
    "test:category": "NODE_ENV=production DISABLE_RATE_LIMITING=true mocha tests/category.test.js --timeout 20000 --exit",
    "test:book": "NODE_ENV=production DISABLE_RATE_LIMITING=true mocha tests/book.test.js --timeout 20000 --exit",
    "test:user": "NODE_ENV=production DISABLE_RATE_LIMITING=true mocha tests/auth.test.js --timeout 20000 --exit",
    "start": "node server.js",
    "start:dev": "NODE_ENV=development npx nodemon server.js",
    "start:prod": "NODE_ENV=production node server.js",
    "debug": "ndb server.js",
    "lintall": "npx eslint .",
    "lint": "npx eslint"
  },
  "keywords": [
    "books",
    "arabic-books",
    "book-sharing",
    "nodejs",
    "express",
    "mongodb",
    "mongoose",
    "aws",
    "s3",
    "jwt-auth",
    "file-upload",
    "book-download",
    "ebook",
    "book-platform",
    "accessible-books",
    "open-library",
    "rest-api",
    "backend"
  ],
  "author": "Bassem Krayem",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1055.0",
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^4.21.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.1.0",
    "hpp": "^0.2.3",
    "joi": "^18.2.1",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.14.3",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.2",
    "nodemailer": "^8.0.9",
    "nodemon": "^3.1.14",
    "swagger-ui-express": "^5.0.1",
    "validator": "^13.15.0",
    "xss-clean": "^0.1.4",
    "yamljs": "^0.3.0"
  },
  "devDependencies": {
    "chai": "^5.2.0",
    "eslint": "^8.57.1",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-prettier": "^5.4.0",
    "eslint-plugin-react": "^7.37.5",
    "mocha": "^11.2.2",
    "prettier": "^3.5.3",
    "supertest": "^7.1.1"
  },
  "engines": {
    "node": ">=20"
  }
}
